{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/forgot-password", "destination": "/forgot-password.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/income", "destination": "/income.html" },
    { "source": "/expenses", "destination": "/expenses.html" },
    { "source": "/transactions", "destination": "/transactions.html" },
    { "source": "/budgets", "destination": "/budgets.html" },
    { "source": "/financial-plans", "destination": "/financial-plans.html" },
    { "source": "/saving-goals", "destination": "/saving-goals.html" },
    { "source": "/debts", "destination": "/debts.html" },
    { "source": "/reports", "destination": "/reports.html" },
    { "source": "/categories", "destination": "/categories.html" },
    { "source": "/notifications", "destination": "/notifications.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
